{
  "name": "converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "fixtures": "bash scripts/fixtures.sh",
    "codecs": "bash scripts/codecs.sh",
    "content": "node scripts/content-md.ts",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:slow": "playwright test --project=slow-chromium --project=slow-webkit",
    "test:e2e:docker": "bash scripts/e2e-docker.sh --project=chromium --project=firefox --project=webkit",
    "test:e2e:slow:docker": "bash scripts/e2e-docker.sh --project=slow-chromium --project=slow-webkit",
    "smoke:docker": "bash scripts/smoke-docker.sh",
    "lighthouse": "bash scripts/lighthouse.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "astro": "7.4.0",
    "client-zip": "2.5.1",
    "jxl-oxide-wasm": "0.12.6",
    "libheif-js": "1.23.5",
    "utif2": "4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "node-html-parser": "9.0.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
