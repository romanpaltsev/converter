# Скопируйте в .env (рядом с docker-compose.yml) и поправьте при необходимости.
# Все значения встраиваются в сайт при сборке образа: после изменения — docker compose up -d --build

# Адрес сайта: canonical, hreflang, sitemap. Переезд на финальный домен — смена этой строки.
SITE_URL=https://converter.hotbar.pro
# true — открыть для поисковиков (robots.txt со ссылкой на sitemap, без noindex)
PUBLIC_INDEXING=false
# места под рекламу и кнопку Pro (пока пустые)
ADS_ENABLED=false
PRO_ENABLED=false
# порт контейнера на 127.0.0.1 сервера
HOST_PORT=8090
