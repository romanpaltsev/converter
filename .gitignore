# зависимости и сборка
node_modules/
/dist/
/.astro/

# локальные переменные окружения
.env
.env.*
!.env.example

# результаты тестов
test-results/
playwright-report/
blob-report/
.vitest/
coverage/

# реальные фото владельца — никогда не коммитим
tests/fixtures/private/*
!tests/fixtures/private/README.md

# прочее
.DS_Store
*.log

# дампы памяти упавших процессов (например, WebKit в Docker-прогоне e2e) — не коммитить
/core.[0-9]*
