---
// Переключатель языка: ведёт на ту же страницу на другом языке (для 404 — на главную).
import { LOCALE_META, LOCALES, type Locale } from '../config/site';
import { pagePath, type PageId } from '../i18n/routes';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
  pageId: PageId | null;
}

const { locale, pageId } = Astro.props;
const targets = LOCALES.filter((l) => l !== locale).map((l) => ({
  locale: l,
  href: pagePath(pageId ?? 'home', l),
  label: LOCALE_META[l].label,
}));
---

<nav class="lang" aria-label={UI[locale].nav.switchLanguage}>
  {
    targets.map((t) => (
      <a href={t.href} hreflang={t.locale} lang={LOCALE_META[t.locale].htmlLang}>
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" />
          <path d="M1.75 8h12.5M8 1.75c1.7 1.8 2.5 3.9 2.5 6.25S9.7 12.45 8 14.25C6.3 12.45 5.5 10.35 5.5 8S6.3 3.55 8 1.75Z" />
        </svg>
        {t.label}
      </a>
    ))
  }
</nav>

<style>
  .lang a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
    color: var(--text);
    transition:
      border-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .lang svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    color: var(--muted);
  }

  .lang a:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
</style>
