---
// Виджет конвертера: разметка рендерится на сервере, поведение — src/converter/widget/controller.ts.
// До выбора первого файла WASM не загружается.
import '../styles/converter.css';
import { LOCALE_META, MAX_FILES_PER_BATCH, type Locale } from '../config/site';
import {
  AUDIO_BITRATES,
  AUDIO_FORMATS,
  DEFAULT_AUDIO_BITRATE,
  DEFAULT_GIF_FPS,
  DEFAULT_GIF_WIDTH,
  DEFAULT_VIDEO_QUALITY,
  GIF_FPS,
  GIF_WIDTHS,
  VIDEO_FORMATS,
  VIDEO_HEIGHTS,
  VIDEO_QUALITIES,
  isAudioTarget,
  isVideoTarget,
} from '../converter/media/formats';
import { STRIP_MODES } from '../converter/metadata/strip/types';
import { PDF_PAGE_LIMIT } from '../converter/pdf/limits';
import type { SniffKind } from '../converter/pipeline/sniff';
import type { OutputOption, WidgetConfig } from '../converter/widget/config';
import { ALL_TARGETS, AUDIO_TARGETS, BOOK_TARGETS, DOCUMENT_TARGETS, IMAGE_TARGETS, TABLE_TARGETS, type TargetId, VIDEO_TARGETS, visibleSettings } from '../converter/widget/targets';
import { pagePath, toolPageId } from '../i18n/routes';
import { UI, format } from '../i18n/ui';
import { BOOK_FORMATS, CATEGORY_SLUGS, DOC_FORMATS, type ToolCategory, categoryInputs, DOCUMENT_FORMATS, INPUT_FORMATS, MEDIA_FORMATS, TEXT_FORMATS, isDocTarget, OUTPUT_FORMATS, SOURCE_FORMATS, type SourceFormatId, type ToolConfig, UNIVERSAL_MODES } from '../tools/registry';

interface Props {
  /** null — главная или страница раздела: универсальный конвертер без предустановки формата. */
  tool: ToolConfig | null;
  /** Страница раздела («Конвертер аудио»): принимает только форматы раздела. */
  category?: ToolCategory;
  locale: Locale;
}

const { tool, category, locale } = Astro.props;
// главная — как пара форматов без своего формата: формат выбирается у каждого файла, файлы ждут выбора
const spec = tool
  ? { ...tool, zipName: tool.slugs.en }
  : {
      id: category ? `category-${category}` : 'home',
      mode: 'convert' as const,
      inputFormats: (category && categoryInputs(category)) || ([...Object.keys(INPUT_FORMATS), 'pdf', ...Object.keys(MEDIA_FORMATS), ...Object.keys(TEXT_FORMATS), ...Object.keys(BOOK_FORMATS)] as SourceFormatId[]),
      defaultOutput: 'original' as const,
      outputs: undefined,
      defaultQuality: 90,
      zipName: category ? CATEGORY_SLUGS[category].en : 'converter',
    };
const list = (items: string[]) => new Intl.ListFormat(LOCALE_META[locale].htmlLang, { type: 'conjunction' }).format(items);
const inputs = spec.inputFormats.map((id) => SOURCE_FORMATS[id]);
const converts = spec.mode === 'convert';
// пары форматов: формат выбирается у каждого файла (меню в строке), предустановка — формат страницы
const universal = UNIVERSAL_MODES.includes(spec.mode);
const preset = universal && spec.defaultOutput !== 'original' ? (spec.defaultOutput as TargetId) : null;
const presetKind = preset ? (spec.inputFormats[0] as SniffKind) : null;
const targetLabel = (target: TargetId) =>
  target === 'pdf' ? DOCUMENT_FORMATS.pdf.label : isDocTarget(target) ? DOC_FORMATS[target].label : isAudioTarget(target) ? AUDIO_FORMATS[target].label : isVideoTarget(target) ? VIDEO_FORMATS[target].label : OUTPUT_FORMATS[target].label;
const targets = ALL_TARGETS.map((target) => ({ id: target, label: targetLabel(target) }));
const TARGET_GROUPS = [
  { name: 'image', targets: IMAGE_TARGETS },
  { name: 'document', targets: DOCUMENT_TARGETS },
  { name: 'table', targets: TABLE_TARGETS },
  { name: 'book', targets: BOOK_TARGETS },
  { name: 'video', targets: VIDEO_TARGETS },
  { name: 'audio', targets: AUDIO_TARGETS },
] as const;
// какие настройки видны до выбора файлов — нужные формату страницы
const shown = visibleSettings(preset && presetKind ? [{ kind: presetKind, target: preset }] : [], false);
// «Удалить метаданные»: без выбора формата и качества — только что удалять
const strips = spec.mode === 'strip';
// «Посмотреть EXIF»: только чтение — ни настроек, ни архива с результатами
const inspects = spec.mode === 'inspect';
// «Объединить PDF»: настроек нет, порядок задают стрелки у файлов, кнопка — «Объединить PDF»
const merges = spec.mode === 'merge-pdf';
// «Изображения в PDF»: размер страницы и поля вместо формата и качества; вместо ZIP — один PDF
const pdfs = spec.mode === 'to-pdf';
const PAGE_SIZES = ['a4', 'letter', 'image'] as const;
const MARGINS = ['none', 'small'] as const;
// «PDF в JPG/PNG»: формат и качество — как у конвертеров, плюс разрешение; метаданных у страниц нет
const fromPdf = spec.mode === 'from-pdf';
const DPI = [72, 150, 300] as const;
// CSV: русский Excel ждёт точку с запятой, англоязычный и Google Таблицы — запятую
const CSV_DELIMITERS = [';', ',', '\t'] as const;
const defaultDelimiter = locale === 'ru' ? ';' : ',';
const DEFAULT_DPI = 150;
// шаблоны строк заполняем здесь: формат страницы и список всех поддерживаемых форматов (универсальный виджет читает и PDF)
const supported = list([...Object.values(INPUT_FORMATS).map((f) => f.label), ...(universal ? [DOCUMENT_FORMATS.pdf.label, ...Object.values(MEDIA_FORMATS).map((f) => f.label), ...Object.values(TEXT_FORMATS).map((f) => f.label), ...Object.values(BOOK_FORMATS).map((f) => f.label)] : [])]);
const base = UI[locale].widget;
const t = {
  ...base,
  dropTitle: !tool
    ? base.dropTitleUniversal
    : converts || pdfs || fromPdf || merges
      ? format(base.dropTitle, { format: list(inputs.map((f) => f.label)) })
      : base.dropTitleAny,
  // сжатие, размер и метаданные — не «конвертация»; PDF в картинки и обратно — она
  progress: converts || pdfs || fromPdf ? base.progress : base.progressProcess,
  converting: converts || pdfs || fromPdf ? base.converting : base.processing,
  reconvert: converts || pdfs || fromPdf ? base.reconvert : base.reprocess,
  errors: {
    ...base.errors,
    'not-image': format(base.errors['not-image'], { formats: supported }),
    'unsupported-image': format(base.errors['unsupported-image'], { formats: supported }),
  },
  warnings: { ...base.warnings, 'pdf-page-limit': format(base.warnings['pdf-page-limit'], { limit: PDF_PAGE_LIMIT }) },
};
const accept = inputs.map((f) => f.accept).join(',');
const outputs: OutputOption[] = (spec.outputs ?? []).map((id) => {
  if (id === 'original') return { id, label: base.originalFormat, encoder: 'original', hasQuality: true, hasLossless: false, largeFiles: false };
  const { label, encoder, hasQuality, hasLossless, largeFiles } = OUTPUT_FORMATS[id];
  return { id, label, encoder, hasQuality, hasLossless, largeFiles };
});
// у универсального виджета общего переключателя нет — видимость настроек задаёт shown
const initial = outputs.find((o) => o.id === spec.defaultOutput) ?? { hasQuality: shown.quality, hasLossless: shown.lossless, largeFiles: shown.pngWarning };
const config: WidgetConfig = {
  toolId: spec.id,
  mode: spec.mode,
  locale,
  universal,
  preset,
  presetKind,
  targets,
  outputs,
  defaultOutput: spec.defaultOutput,
  maxFiles: MAX_FILES_PER_BATCH,
  zipName: spec.zipName,
  iphoneHint: tool !== null && converts && spec.inputFormats.includes('heic'),
  strings: t,
};
const id = `cv-${spec.id}`;
// «Изменить размер»: режимы и готовые размеры по длинной стороне (4K, 2,5K, Full HD, HD, превью)
const RESIZE_MODES = [
  { value: 'long-side', label: t.resizeLongSide },
  { value: 'percent', label: t.resizePercent },
  { value: 'box', label: t.resizeBox },
];
const LONG_SIDE_PRESETS = [3840, 2560, 1920, 1280, 800];
const DEFAULT_LONG_SIDE = 1920;
---

<section class="converter" data-converter aria-label={t.dropTitle}>
  <script type="application/json" data-converter-config set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
  <button type="button" class="dropzone" data-dropzone aria-describedby={`${id}-hint`}>
    <span class="dropzone__button">
      <svg class="dropzone__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span class="dropzone__title">{t.dropTitle}</span>
    </span>
    <span class="dropzone__action">{t.dropAction}</span>
    <span class="dropzone__hint" id={`${id}-hint`}>{t.dropHint}</span>
  </button>
  <input type="file" class="visually-hidden" data-input multiple accept={accept} tabindex="-1" aria-hidden="true" />

  <form class="settings" data-settings aria-label={t.settings} hidden={inspects || merges || (universal && !Object.values(shown).some(Boolean))}>
    {
      !inspects && !merges && (
        <Fragment>
          {
            strips ? (
              <Fragment>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.stripWhat}</legend>
                  <div class="segmented segmented--stack">
                    {STRIP_MODES.map((mode) => (
                      <label class="segmented__option">
                        <input type="radio" name="stripMode" value={mode} checked={mode === 'all'} />
                        <span>{t.stripModes[mode]}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned" data-strip-hint>{t.stripHints.all}</p>
              </Fragment>
            ) : pdfs || universal ? null : (
              <fieldset class="settings__format">
                <legend class="settings__label">{t.format}</legend>
                <div class="segmented">
                  {outputs.map((output) => (
                    <label class="segmented__option">
                      <input type="radio" name="format" value={output.id} checked={output.id === spec.defaultOutput} />
                      <span>{output.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }
          {
            (pdfs || universal) && (
              <div class="settings__group" data-pdf-layout-row hidden={universal && !shown.pdfLayout}>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.pageSize}</legend>
                  <div class="segmented">
                    {PAGE_SIZES.map((size) => (
                      <label class="segmented__option">
                        <input type="radio" name="pageSize" value={size} checked={size === 'a4'} />
                        <span>{t.pageSizes[size]}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.margin}</legend>
                  <div class="segmented">
                    {MARGINS.map((margin) => (
                      <label class="segmented__option">
                        <input type="radio" name="margin" value={margin} checked={margin === 'none'} />
                        <span>{t.margins[margin]}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.pdfHint}</p>
                {
                  universal && (
                    <p class="settings__hint settings__hint--aligned">
                      {t.pdfCombineHint} <a href={pagePath(toolPageId('jpg-to-pdf'), locale)}>{t.pdfCombineLink}</a>.
                    </p>
                  )
                }
              </div>
            )
          }
          {
            universal && (
              <div class="settings__group" data-dpi-row hidden={!shown.dpi}>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.resolution}</legend>
                  <div class="segmented">
                    {DPI.map((dpi) => (
                      <label class="segmented__option">
                        <input type="radio" name="dpi" value={dpi} checked={dpi === DEFAULT_DPI} />
                        <span>{format(t.dpi, { value: dpi })}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.pdfRenderHint}</p>
              </div>
            )
          }
          {
            universal && (
              <div class="settings__group" data-audio-bitrate-row hidden={!shown.audioBitrate}>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.audioBitrate}</legend>
                  <div class="segmented">
                    {AUDIO_BITRATES.map((bitrate) => (
                      <label class="segmented__option">
                        <input type="radio" name="audioBitrate" value={bitrate} checked={bitrate === DEFAULT_AUDIO_BITRATE} />
                        <span>{bitrate}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.audioHint}</p>
              </div>
            )
          }
          {
            universal && (
              <div class="settings__group" data-video-row hidden={!shown.video}>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.videoQuality}</legend>
                  <div class="segmented">
                    {VIDEO_QUALITIES.map((quality) => (
                      <label class="segmented__option">
                        <input type="radio" name="videoQuality" value={quality} checked={quality === DEFAULT_VIDEO_QUALITY} />
                        <span>{t.videoQualities[quality]}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.videoHeight}</legend>
                  <div class="segmented">
                    {VIDEO_HEIGHTS.map((height) => (
                      <label class="segmented__option">
                        <input type="radio" name="videoHeight" value={height} checked={height === 0} />
                        <span>{height === 0 ? t.videoOriginal : `${height}p`}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.videoHint}</p>
              </div>
            )
          }
          {
            universal && (
              <div class="settings__group" data-csv-row hidden={!shown.csv}>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.csvDelimiter}</legend>
                  <div class="segmented">
                    {CSV_DELIMITERS.map((delimiter) => (
                      <label class="segmented__option">
                        <input type="radio" name="csvDelimiter" value={delimiter} checked={delimiter === defaultDelimiter} />
                        <span>{t.csvDelimiters[delimiter]}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.csvHint}</p>
              </div>
            )
          }
          {
            universal && (
              <div class="settings__group" data-gif-row hidden={!shown.gif}>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.gifWidth}</legend>
                  <div class="segmented">
                    {GIF_WIDTHS.map((width) => (
                      <label class="segmented__option">
                        <input type="radio" name="gifWidth" value={width} checked={width === DEFAULT_GIF_WIDTH} />
                        <span>{width}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.gifFps}</legend>
                  <div class="segmented">
                    {GIF_FPS.map((fps) => (
                      <label class="segmented__option">
                        <input type="radio" name="gifFps" value={fps} checked={fps === DEFAULT_GIF_FPS} />
                        <span>{fps}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.gifHint}</p>
              </div>
            )
          }
          {
            universal && (
              <Fragment>
                <p class="settings__hint settings__hint--flush" data-ico-hint hidden={!shown.icoHint}>
                  {t.icoHint}
                </p>
                <p class="settings__hint settings__hint--flush" data-avif-hint hidden={!shown.avifHint}>
                  {t.avifHint}
                </p>
              </Fragment>
            )
          }
          {!converts && !strips && !pdfs && !fromPdf && <p class="settings__hint settings__hint--aligned" data-original-hint hidden={spec.defaultOutput !== 'original'}>{t.originalHint}</p>}
          {
            spec.mode === 'compress' && (
              <fieldset class="settings__format" data-compression-row>
                <legend class="settings__label">{t.compression}</legend>
                <div class="segmented">
                  <label class="segmented__option">
                    <input type="radio" name="compression" value="quality" checked />
                    <span>{t.byQuality}</span>
                  </label>
                  <label class="segmented__option">
                    <input type="radio" name="compression" value="target" />
                    <span>{t.byTarget}</span>
                  </label>
                </div>
              </fieldset>
            )
          }
          {
            spec.mode === 'resize' && (
              <Fragment>
                <fieldset class="settings__format">
                  <legend class="settings__label">{t.resize}</legend>
                  <div class="segmented segmented--stack">
                    {RESIZE_MODES.map((mode) => (
                      <label class="segmented__option">
                        <input type="radio" name="resizeMode" value={mode.value} checked={mode.value === 'long-side'} />
                        <span>{mode.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <p class="settings__hint settings__hint--aligned">{t.resizeHint}</p>
                <div class="settings__target" data-resize-long>
                  <label class="settings__label" for={`${id}-long`}>{t.longSide}</label>
                  <div class="field-group">
                    <span class="field-unit">
                      <input id={`${id}-long`} class="field field--number" type="text" name="longSide" value={DEFAULT_LONG_SIDE} inputmode="numeric" autocomplete="off" />
                      <span class="field-unit__label">{t.pixels}</span>
                    </span>
                    <div class="chips" role="group" aria-label={t.presets}>
                      {LONG_SIDE_PRESETS.map((size) => (
                        <button type="button" class="chip" data-preset={size} aria-pressed={size === DEFAULT_LONG_SIDE ? 'true' : 'false'}>
                          {size}
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="settings__quality settings__quality--wide" data-resize-percent hidden>
                  <label class="settings__label" for={`${id}-percent`}>{t.scale}</label>
                  <input id={`${id}-percent`} type="range" name="percent" min="5" max="100" step="5" value="50" />
                  <output for={`${id}-percent`} data-percent-value>50 %</output>
                </div>
                <div class="settings__target" data-resize-box hidden>
                  <span class="settings__label" aria-hidden="true"></span>
                  <div class="field-group">
                    <label class="field-caption">
                      <span>{t.width}</span>
                      <input class="field field--number" type="text" name="boxWidth" value="1920" inputmode="numeric" autocomplete="off" />
                    </label>
                    <span class="field-times" aria-hidden="true">×</span>
                    <label class="field-caption">
                      <span>{t.height}</span>
                      <input class="field field--number" type="text" name="boxHeight" value="1080" inputmode="numeric" autocomplete="off" />
                    </label>
                    <span class="field-unit__label field-times">{t.pixels}</span>
                  </div>
                  <label class="checkbox settings__target-span">
                    <input type="checkbox" name="keepAspect" checked />
                    <span>{t.keepAspect}</span>
                  </label>
                  <p class="settings__hint settings__hint--flush settings__target-span">{t.boxHint}</p>
                </div>
              </Fragment>
            )
          }
          {
            !strips && !pdfs && (
              <div class="settings__quality" data-quality-row hidden={!initial.hasQuality}>
                <label class="settings__label" for={`${id}-quality`}>{t.quality}</label>
                <input id={`${id}-quality`} type="range" name="quality" min="1" max="100" step="1" value={spec.defaultQuality} data-quality />
                <output for={`${id}-quality`} data-quality-value>{spec.defaultQuality}</output>
              </div>
            )
          }
          {
            spec.mode === 'compress' && (
              <div class="settings__target" data-target-row hidden>
                <label class="settings__label" for={`${id}-target`}>{t.targetSize}</label>
                <div class="field-group">
                  <input id={`${id}-target`} class="field field--number" type="text" name="targetSize" value="500" inputmode="decimal" autocomplete="off" aria-describedby={`${id}-target-hint`} />
                  <div class="segmented" role="radiogroup" aria-label={t.targetUnit}>
                    <label class="segmented__option">
                      <input type="radio" name="targetUnit" value="kb" checked />
                      <span>{t.units.kb}</span>
                    </label>
                    <label class="segmented__option">
                      <input type="radio" name="targetUnit" value="mb" />
                      <span>{t.units.mb}</span>
                    </label>
                  </div>
                </div>
                <p class="settings__hint settings__hint--flush" id={`${id}-target-hint`}>{t.targetHint}</p>
              </div>
            )
          }
          {
            !strips && !pdfs && (
              <Fragment>
                <label class="checkbox settings__lossless" data-lossless-row hidden={!initial.hasLossless}>
                  <input type="checkbox" name="lossless" />
                  <span>{t.lossless}</span>
                </label>
                {
                  (universal || !fromPdf) && (
                    <Fragment>
                      <div class="settings__meta" data-meta-row hidden={universal ? !shown.metadata : spec.defaultOutput === 'ico'}>
                        <label class="checkbox">
                          <input type="checkbox" name="keepMetadata" aria-describedby={`${id}-meta-hint`} />
                          <span>{t.keepMetadata}</span>
                        </label>
                        <p class="settings__hint" id={`${id}-meta-hint`}>{t.keepMetadataHint}</p>
                      </div>
                      <p class="notice notice--warning" data-png-warning hidden={!initial.largeFiles}>{converts ? t.pngWarning : t.pngCompressWarning}</p>
                    </Fragment>
                  )
                }
              </Fragment>
            )
          }
        </Fragment>
      )
    }
  </form>

  <noscript><p class="notice notice--error">{t.noscript}</p></noscript>
  <p class="notice" data-notice aria-live="polite" hidden></p>
  <p class="converter__status" data-status-text role="status" aria-live="polite"></p>

  <div class="converter__results" data-results hidden>
    {
      universal && (
        <div class="files-toolbar" data-target-all-row hidden>
          <span class="files-toolbar__label" aria-hidden="true">
            {t.allTo}
          </span>
          <button
            type="button"
            class="target-button"
            data-target-all
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls={`${id}-picker`}
            aria-label={format(t.allLabel, { target: t.chooseTarget })}
          >
            {t.chooseTarget}
          </button>
        </div>
      )
    }
    <ul class="files" data-files></ul>
    <p class="settings__hint" data-settings-hint hidden>{t.settingsChanged}</p>
    {merges && <p class="settings__hint">{t.mergeHint}</p>}
    <div class="converter__actions">
      <button type="button" class="button button--primary" data-zip disabled hidden={inspects}>{merges ? t.mergePdf : pdfs ? t.downloadPdf : t.downloadAll}</button>
      <button type="button" class="button" data-reconvert hidden>{t.reconvert}</button>
      <button type="button" class="button button--ghost" data-clear>{t.clear}</button>
    </div>
    {
      universal && (
        <div class="picker" id={`${id}-picker`} data-picker role="menu" aria-label={t.targetMenu} hidden>
          {TARGET_GROUPS.map((group) => (
            <div class="picker__group" role="group" aria-label={t.targetGroups[group.name]}>
              <span class="picker__title" aria-hidden="true">
                {t.targetGroups[group.name]}
              </span>
              {group.targets.map((target) => (
                <button type="button" class="picker__item" role="menuitemradio" aria-checked="false" data-target={target} tabindex="-1">
                  {targetLabel(target)}
                </button>
              ))}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

