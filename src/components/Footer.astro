---
import { SITE_NAME, type Locale } from '../config/site';
import { pagePath, toolPageId } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { TOOLS } from '../tools/registry';
import { getEntry } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const tools = await Promise.all(
  TOOLS.map(async (tool) => {
    const entry = await getEntry('tools', `${locale}/${tool.content}`);
    return { href: pagePath(toolPageId(tool.id), locale), title: entry?.data.card.title ?? tool.id };
  }),
);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{SITE_NAME[locale]}</p>
      <p class="footer__privacy">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <rect x="3" y="7" width="10" height="7" rx="2"></rect>
          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"></path>
        </svg>
        {t.footer.privacy}
      </p>
    </div>
    <nav aria-label={t.nav.siteLinks}>
      <ul class="footer__links">
        {
          tools.map((tool) => (
            <li>
              <a href={tool.href}>{tool.title}</a>
            </li>
          ))
        }
      </ul>
      <ul class="footer__links footer__links--secondary">
        <li><a href={pagePath('licenses', locale)}>{t.nav.licenses}</a></li>
        <li><a href={pagePath('contacts', locale)}>{t.nav.contacts}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(64px, 8vw, 96px);
    padding: 40px 0 48px;
    border-top: 1px solid var(--border);
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .footer__inner {
    display: grid;
    gap: 28px;
  }

  .footer__name {
    margin: 0 0 6px;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer__privacy {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    max-width: 30rem;
    margin: 0;
  }

  .footer__privacy svg {
    flex: none;
    margin-top: 3px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links--secondary {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .footer__links a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--text);
    text-decoration: underline;
  }
</style>
