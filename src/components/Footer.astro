---
// Тёмный подвал: колонки ссылок на все инструменты (по группам) и страницы сайта, внизу — название и обещание
// приватности. Ссылка «Контакты» на странице одна — по ней её находят тесты и пользователи.
import { SITE_NAME, type Locale } from '../config/site';
import { categoryPageId, pagePath } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { toolLinks } from '../lib/tool-links';
import { toolGroups } from '../tools/registry';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
// заголовок колонки раздела ведёт на страницу раздела («Изображения» → «Конвертер изображений»)
const groups = await Promise.all(
  toolGroups().map(async (group) => ({ id: group.id, title: t.nav.groups[group.id], href: pagePath(categoryPageId(group.id), locale), links: await toolLinks(group.tools, locale) })),
);
const columns = [
  ...groups,
  {
    id: 'about',
    title: t.nav.groups.about,
    href: null,
    links: [
      { href: pagePath('licenses', locale), title: t.nav.licenses },
      { href: pagePath('contacts', locale), title: t.nav.contacts },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <nav class="footer__nav" aria-label={t.nav.siteLinks}>
      {
        columns.map((column) => (
          <div class={`footer__group footer__group--${column.id}`}>
            <p class="footer__title" id={`footer-${column.id}`}>
              {column.href ? <a href={column.href}>{column.title}</a> : column.title}
            </p>
            <ul class="footer__links" aria-labelledby={`footer-${column.id}`}>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <div class="footer__bottom">
      <p class="footer__name">{SITE_NAME[locale]}</p>
      <p class="footer__privacy">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <rect x="3" y="7" width="10" height="7" rx="2"></rect>
          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"></path>
        </svg>
        {t.footer.privacy}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(64px, 8vw, 96px);
    padding: 48px 0 32px;
    background: var(--footer-bg);
    color: var(--footer-text);
    font-size: 0.9375rem;
  }

  .footer :focus-visible {
    outline-color: var(--footer-focus);
  }

  /* разделы — колонками по ширине (на телефоне — по две); «Изображения» — первой строкой во всю ширину */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: 32px 24px;
  }

  .footer__group--images {
    grid-column: 1 / -1;
  }

  .footer__group--images .footer__links {
    display: block;
    columns: 9.5rem auto;
    column-gap: 24px;
  }

  .footer__group--images li {
    margin-bottom: 8px;
    break-inside: avoid;
  }

  .footer__title {
    margin: 0 0 14px;
    color: var(--footer-heading);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .footer__links {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__title a {
    color: inherit;
    text-decoration: none;
  }

  .footer__title a:hover {
    text-decoration: underline;
  }

  .footer__links a {
    color: var(--footer-text);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--footer-heading);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--footer-border);
  }

  .footer__name {
    margin: 0;
    color: var(--footer-heading);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer__privacy {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0;
  }

  .footer__privacy svg {
    flex: none;
    margin-top: 3px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
</style>
