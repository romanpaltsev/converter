---
// Страница-конвертер: H1 и подзаголовок, виджет в первом экране, инструкция, «Почему здесь», FAQ, перелинковка.
import { getEntry } from 'astro:content';
import '../../styles/page.css';
import AdSlot from '../AdSlot.astro';
import ConverterWidget from '../ConverterWidget.astro';
import ToolCards from '../ToolCards.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../config/site';
import { absoluteUrl, categoryPageId, pagePath, toolPageId } from '../../i18n/routes';
import { UI } from '../../i18n/ui';
import { breadcrumbList, faqPage, webApplication } from '../../lib/seo';
import { getTool, relatedTools, toolCategory } from '../../tools/registry';

interface Props {
  toolId: string;
  locale: Locale;
}

const { toolId, locale } = Astro.props;
const tool = getTool(toolId);
const entry = await getEntry('tools', `${locale}/${tool.content}`);
if (!entry) throw new Error(`Нет текстов ${locale}/${tool.content}`);
const c = entry.data;
const pageId = toolPageId(tool.id);
const site = import.meta.env.SITE;
const url = absoluteUrl(site, pagePath(pageId, locale));
// хлебные крошки: главная → раздел («Конвертер аудио») → инструмент
const category = toolCategory(tool);
const categoryEntry = await getEntry('pages', `${locale}/category-${category}`);
if (categoryEntry?.data.page !== 'category') throw new Error(`Нет текстов раздела ${category} (${locale})`);
const categoryCrumb = { name: categoryEntry.data.breadcrumb, href: pagePath(categoryPageId(category), locale) };
const jsonLd = [
  webApplication({ name: c.app.name, description: c.app.description, url, locale }),
  faqPage(c.faq.items),
  breadcrumbList([
    { name: UI[locale].nav.home, url: absoluteUrl(site, pagePath('home', locale)) },
    { name: categoryCrumb.name, url: absoluteUrl(site, categoryCrumb.href) },
    { name: c.breadcrumb, url },
  ]),
];
---

<BaseLayout locale={locale} pageId={pageId} title={c.title} description={c.description} jsonLd={jsonLd}>
  <div class="container container--narrow">
    <div class="hero">
      <nav class="breadcrumbs" aria-label={UI[locale].nav.breadcrumbs}>
        <a href={pagePath('home', locale)}>{UI[locale].nav.home}</a>
        <span aria-hidden="true">/</span>
        <a href={categoryCrumb.href}>{categoryCrumb.name}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{c.breadcrumb}</span>
      </nav>
      <h1>{c.h1}</h1>
      <p class="lead">{c.subtitle}</p>
    </div>
  </div>

  <div class="container container--widget">
    <ConverterWidget tool={tool} locale={locale} />

    <AdSlot locale={locale} placement="tool-after-widget" />

    <section class="section">
      <h2>{c.howTo.title}</h2>
      <ol class="steps">
        {c.howTo.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
  </div>

  <section class="band">
    <div class="container container--widget">
      <h2>{c.why.title}</h2>
      <ul class="features">
        {
          c.why.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="container container--narrow">
    <section class="section">
      <h2>{c.faq.title}</h2>
      <div class="faq">
        {
          c.faq.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <div class="container container--widget">
    <section class="section related">
      <h2>{UI[locale].tool.relatedTitle}</h2>
      <ToolCards locale={locale} toolIds={relatedTools(tool).map((t) => t.id)} />
    </section>
  </div>
</BaseLayout>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-bottom: 12px;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* четыре соседних инструмента — в ряд, на узком экране 2 × 2 или столбиком */
  .related :global(.cards) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  }

  /* на телефоне номер шага — слева от текста: карточки вдвое ниже */
  @media (max-width: 480px) {
    .steps li {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: start;
      gap: 14px;
      padding: 16px;
    }

    .steps li::before {
      margin-bottom: 0;
    }
  }
</style>
