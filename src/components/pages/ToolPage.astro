---
// Страница-конвертер: H1 и подзаголовок, виджет в первом экране, инструкция, «Почему здесь», FAQ, перелинковка.
import { getEntry } from 'astro:content';
import AdSlot from '../AdSlot.astro';
import ConverterWidget from '../ConverterWidget.astro';
import ToolCards from '../ToolCards.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../config/site';
import { absoluteUrl, pagePath, toolPageId } from '../../i18n/routes';
import { UI } from '../../i18n/ui';
import { breadcrumbList, faqPage, webApplication } from '../../lib/seo';
import { getTool, relatedTools } from '../../tools/registry';

interface Props {
  toolId: string;
  locale: Locale;
}

const { toolId, locale } = Astro.props;
const tool = getTool(toolId);
const entry = await getEntry('tools', `${locale}/${tool.content}`);
if (!entry) throw new Error(`Нет текстов ${locale}/${tool.content}`);
const c = entry.data;
const pageId = toolPageId(tool.id);
const site = import.meta.env.SITE;
const url = absoluteUrl(site, pagePath(pageId, locale));
const jsonLd = [
  webApplication({ name: c.app.name, description: c.app.description, url, locale }),
  faqPage(c.faq.items),
  breadcrumbList([
    { name: UI[locale].nav.home, url: absoluteUrl(site, pagePath('home', locale)) },
    { name: c.breadcrumb, url },
  ]),
];
---

<BaseLayout locale={locale} pageId={pageId} title={c.title} description={c.description} jsonLd={jsonLd}>
  <div class="container container--narrow">
    <div class="hero">
      <nav class="breadcrumbs" aria-label={UI[locale].nav.breadcrumbs}>
        <a href={pagePath('home', locale)}>{UI[locale].nav.home}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{c.breadcrumb}</span>
      </nav>
      <h1>{c.h1}</h1>
      <p class="lead">{c.subtitle}</p>
    </div>
  </div>

  <div class="container container--widget">
    <ConverterWidget tool={tool} locale={locale} />

    <AdSlot locale={locale} placement="tool-after-widget" />

    <section class="section">
      <h2>{c.howTo.title}</h2>
      <ol class="steps">
        {c.howTo.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
  </div>

  <section class="band">
    <div class="container container--widget">
      <h2>{c.why.title}</h2>
      <ul class="features">
        {
          c.why.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="container container--narrow">
    <section class="section">
      <h2>{c.faq.title}</h2>
      <div class="faq">
        {
          c.faq.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <div class="container container--widget">
    <section class="section related">
      <h2>{UI[locale].tool.relatedTitle}</h2>
      <ToolCards locale={locale} toolIds={relatedTools(tool).map((t) => t.id)} />
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: clamp(20px, 4vw, 48px) 0 clamp(20px, 3vw, 32px);
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 14px;
  }

  .hero .lead {
    max-width: 34rem;
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .breadcrumbs span[aria-hidden] {
    opacity: 0.5;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-bottom: 12px;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* четыре соседних инструмента — в ряд, на узком экране 2 × 2 или столбиком */
  .related :global(.cards) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  }

  .faq {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .faq details + details {
    border-top: 1px solid var(--border);
  }

  .faq summary {
    position: relative;
    padding: 16px 52px 16px 20px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s var(--ease);
  }

  .faq summary:hover {
    background: var(--surface-muted);
  }

  .faq summary:focus-visible {
    outline-offset: -2px;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  /* шеврон: поворачивается при раскрытии */
  .faq summary::after {
    content: '';
    position: absolute;
    right: 20px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -7px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.25s var(--ease);
  }

  .faq details[open] summary::after {
    margin-top: -2px;
    transform: rotate(-135deg);
  }

  .faq p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--muted);
  }
</style>
