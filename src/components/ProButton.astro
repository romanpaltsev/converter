---
// Место под кнопку тарифа Pro. При PRO_ENABLED=false не выводит ничего.
import { PRO_ENABLED } from 'astro:env/server';
---

{
  PRO_ENABLED && (
    <a class="pro" href="#pro">
      Pro
    </a>
  )
}

<style>
  .pro {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: none;
  }
</style>
